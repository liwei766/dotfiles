[
  // ── Terminal ──
  { "key": "ctrl+`", "command": "workbench.action.terminal.toggleTerminal" },
  { "key": "ctrl+shift+`", "command": "workbench.action.terminal.new" },

  // ── Split navigation (match Ghostty/Vim) ──
  { "key": "cmd+alt+left", "command": "workbench.action.focusLeftGroup" },
  { "key": "cmd+alt+right", "command": "workbench.action.focusRightGroup" },
  { "key": "cmd+alt+up", "command": "workbench.action.focusAboveGroup" },
  { "key": "cmd+alt+down", "command": "workbench.action.focusBelowGroup" },

  // ── Quick panel navigation ──
  { "key": "ctrl+j", "command": "selectNextSuggestion", "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible" },
  { "key": "ctrl+k", "command": "selectPrevSuggestion", "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible" },
  { "key": "ctrl+j", "command": "workbench.action.quickOpenSelectNext", "when": "inQuickOpen" },
  { "key": "ctrl+k", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen" },

  // ── File explorer ──
  { "key": "cmd+shift+e", "command": "workbench.view.explorer" },

  // ── Zen mode ──
  { "key": "cmd+k z", "command": "workbench.action.toggleZenMode" }
]
